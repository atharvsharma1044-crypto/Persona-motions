# ==============================================================================
# PersonaMotion Web Environment Configuration
# ==============================================================================

# Database (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/personamotion?schema=public"

# Redis (BullMQ queue & caching)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_TLS="false"

# Cloudflare R2 / AWS S3 Object Storage
STORAGE_PROVIDER="r2" # or "s3"
AWS_REGION="auto" # or "us-east-1"
AWS_ACCESS_KEY_ID="your_r2_or_s3_access_key"
AWS_SECRET_ACCESS_KEY="your_r2_or_s3_secret_key"
AWS_S3_BUCKET="personamotion-vault"
AWS_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
NEXT_PUBLIC_STORAGE_CDN_URL="https://pub-your-bucket-id.r2.dev"

# Serverless GPU Inference (Modal.com or Fal.ai / RunPod)
MODAL_API_URL="https://your-workspace--personamotion-inference-web-endpoint.modal.run"
MODAL_API_TOKEN="your_modal_auth_token"
FAL_KEY="your_fal_ai_key"

# AI Storyboard LLM (OpenAI / Anthropic / Groq)
OPENAI_API_KEY="sk-proj-your-openai-api-key"
OPENAI_MODEL="gpt-4o"

# Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
JWT_SECRET="super-secret-jwt-signing-key"
